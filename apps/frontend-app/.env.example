# Questo file documenta le variabili di ambiente necessarie per TrovaMi
# Copia questo file in .env.local e compila con i tuoi valori reali
# È parte del modulo apps/frontend-app
# NON committare MAI chiavi reali in questo file.

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
NEXT_PUBLIC_APP_URL=https://trovami.pro

# Cron job authentication (genera con: openssl rand -hex 32)
CRON_SECRET=your_cron_secret

# Stripe Configuration
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (create these in your Stripe dashboard)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID=price_your_starter_plan_price_id
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_your_pro_plan_price_id

# Klaviyo Configuration
KLAVIYO_PRIVATE_API_KEY=your_klaviyo_private_key
NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=your_klaviyo_public_key
KLAVIYO_LIST_ID=your_klaviyo_list_id

# SEO and Analytics Configuration
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret
INDEXNOW_KEY=your_indexnow_api_key
GOOGLE_SEARCH_CONSOLE_VERIFICATION=your_google_verification_code

# SMTP (email transazionali)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="TrovaMi <noreply@trovami.pro>"

# Development
NODE_ENV=development
