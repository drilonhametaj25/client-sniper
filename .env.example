# ClientSniper - Configurazione Ambiente
# Copia questo file in .env e compila con i tuoi valori reali.
# NON committare MAI chiavi reali in questo file.

# === FRONTEND APP ===
# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
STRIPE_PUBLIC_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_STARTER_PRICE_ID=price_starter_plan_id
STRIPE_PRO_PRICE_ID=price_pro_plan_id

# === SCRAPING ENGINE ===
# Supabase per scraping engine
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Debug
DEBUG=false

# === DEPLOYMENT ===
NODE_ENV=development
PORT=4000
